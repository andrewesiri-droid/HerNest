rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Summary document — same user only
    match /users/{userId}/summary/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Partner view — authenticated users can read any user's profile, tasks, school data
    // (read-only, limited fields via app logic)
    match /users/{userId}/data/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Circle community rooms — any authenticated user can read/write
    match /circle_rooms/{roomId}/messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
